<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PushPrint" Width="1220" Height="840" MinWidth="980" MinHeight="640"
        Background="{DynamicResource BgBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="212"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ================= Sidebar ================= -->
    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,16,12,12">
        <StackPanel DockPanel.Dock="Top" Margin="10,0,10,22">
          <StackPanel Orientation="Horizontal">
            <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0">
              <TextBlock Text="P" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="PushPrint" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Name="VersionText" Text="v0.2.0" Style="{DynamicResource Muted}" FontSize="11"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <Border Style="{DynamicResource Card}" Padding="10" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Text="Admin account" Style="{DynamicResource Muted}"/>
              <TextBlock Name="CredText" Text="not set" TextWrapping="Wrap" Margin="0,2,0,6"/>
              <Button Name="CredButton" Content="Set credentials" HorizontalAlignment="Stretch"/>
            </StackPanel>
          </Border>
          <Button Name="ThemeToggle" Content="Switch theme" Style="{DynamicResource GhostButton}" HorizontalAlignment="Stretch"/>
        </StackPanel>

        <StackPanel>
          <RadioButton Name="NavInstall"   Content="Install"   GroupName="Nav" IsChecked="True" Style="{DynamicResource NavItem}"/>
          <RadioButton Name="NavMachines"  Content="Machines"  GroupName="Nav" Style="{DynamicResource NavItem}"/>
          <RadioButton Name="NavDiscovery" Content="Discovery" GroupName="Nav" Style="{DynamicResource NavItem}"/>
          <RadioButton Name="NavCatalog"   Content="Catalog"   GroupName="Nav" Style="{DynamicResource NavItem}"/>
          <RadioButton Name="NavSettings"  Content="Settings"  GroupName="Nav" Style="{DynamicResource NavItem}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ================= Content ================= -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="170" MinHeight="90"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="24,20,24,8">

        <!-- ~~~~~ Install ~~~~~ -->
        <Grid Name="PageInstall">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Install a printer" Style="{DynamicResource H1}"/>
            <TextBlock Text="Pick a printer from the catalog, choose the target computers and press Install. Nothing is needed on the target except the admin share and DCOM." Style="{DynamicResource Muted}"/>
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource Card}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Printer" Style="{DynamicResource H2}"/>
                <Grid Grid.Row="1" Margin="0,0,0,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ComboBox Grid.Column="0" Name="InstallSite" Margin="0,0,8,0" ToolTip="Filter by site"/>
                  <TextBox Grid.Column="1" Name="InstallSearch" ToolTip="Type to filter by name, IP, model, location"/>
                  <Button Grid.Column="2" Name="InstallReload" Content="Reload" Margin="8,0,0,0" ToolTip="Reload the catalog from disk"/>
                </Grid>
                <DataGrid Grid.Row="2" Name="InstallGrid" IsReadOnly="True" SelectionMode="Single">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding name}" Width="2*"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding ip}" Width="105"/>
                    <DataGridTextColumn Header="Vendor" Binding="{Binding vendor}" Width="70"/>
                    <DataGridTextColumn Header="Model" Binding="{Binding model}" Width="2*"/>
                    <DataGridTextColumn Header="Site" Binding="{Binding site}" Width="70"/>
                    <DataGridTextColumn Header="Queue" Binding="{Binding queueKind}" Width="60"/>
                    <DataGridTextColumn Header="Location" Binding="{Binding location}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource Card}">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="Target" Style="{DynamicResource H2}"/>
                  <TextBlock Text="Computer name(s)" Style="{DynamicResource FieldLabel}" Margin="0,0,0,4"/>
                  <TextBox Name="InstallComputers" AcceptsReturn="True" Height="56" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" ToolTip="One or more, separated by comma, space or new line"/>
                  <DockPanel Margin="0,6,0,0">
                    <Button Name="InstallPing" Content="Ping" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                    <ComboBox Name="InstallRecent" ToolTip="Recently used computers"/>
                  </DockPanel>

                  <TextBlock Text="Printer settings" Style="{DynamicResource H2}" Margin="0,14,0,6"/>
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Name="ModeDirect" Content="Direct IP" IsChecked="True" GroupName="Mode"/>
                    <RadioButton Name="ModeServer" Content="Print server queue" GroupName="Mode"/>
                  </StackPanel>
                  <TextBlock Text="Printer name" Style="{DynamicResource FieldLabel}"/>
                  <TextBox Name="InstallName"/>
                  <Grid Name="DirectPanel">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="IP address" Style="{DynamicResource FieldLabel}"/>
                      <TextBox Name="InstallIp"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Vendor / driver" Style="{DynamicResource FieldLabel}"/>
                      <ComboBox Name="InstallVendor"/>
                    </StackPanel>
                  </Grid>
                  <StackPanel Name="ServerPanel" Visibility="Collapsed">
                    <TextBlock Text="Print server" Style="{DynamicResource FieldLabel}"/>
                    <ComboBox Name="InstallServer" IsEditable="True"/>
                    <TextBlock Text="The queue's share name goes in 'Printer name'. The connection is created in the logged-on user's session (Point and Print)." Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox Name="InstallDefault" Content="Set as default"/>
                    <CheckBox Name="InstallTestPage" Content="Print test page"/>
                  </StackPanel>
                  <Button Name="InstallRun" Content="Install" Style="{DynamicResource PrimaryButton}" Height="40" Margin="0,14,0,0" HorizontalAlignment="Stretch" FontSize="14"/>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>

        <!-- ~~~~~ Machines ~~~~~ -->
        <Grid Name="PageMachines" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Machines" Style="{DynamicResource H1}"/>
            <TextBlock Text="See what is installed on a computer, including the logged-on user's print server connections, and remove what should not be there." Style="{DynamicResource Muted}"/>
          </StackPanel>
          <Border Grid.Row="1" Style="{DynamicResource Card}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <Button Name="MachineRemove" Content="Remove selected" Style="{DynamicResource DangerButton}" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                <Button Name="MachineList" Content="List printers" Style="{DynamicResource PrimaryButton}" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                <TextBlock Text="Computer" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Name="MachineName" IsEditable="True" Width="260" HorizontalAlignment="Left"/>
              </DockPanel>
              <DataGrid Grid.Row="1" Name="MachineGrid" IsReadOnly="True" SelectionMode="Extended">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Printer" Binding="{Binding Name}" Width="2*"/>
                  <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="90"/>
                  <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="140"/>
                  <DataGridTextColumn Header="Host" Binding="{Binding HostAddress}" Width="130"/>
                  <DataGridTextColumn Header="Driver" Binding="{Binding Driver}" Width="2*"/>
                  <DataGridCheckBoxColumn Header="Default" Binding="{Binding Default}" Width="70"/>
                  <DataGridTextColumn Header="User" Binding="{Binding User}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
        </Grid>

        <!-- ~~~~~ Discovery ~~~~~ -->
        <Grid Name="PageDiscovery" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Discovery" Style="{DynamicResource H1}"/>
            <TextBlock Text="Scan the subnets of an AD site over SNMP, cross-check with DHCP and the print servers, and merge the verified result into the catalog." Style="{DynamicResource Muted}"/>
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{DynamicResource Card}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Scope" Style="{DynamicResource H2}"/>
                <StackPanel Grid.Row="1">
                  <DockPanel>
                    <Button Name="DiscLoadSites" Content="Load sites" DockPanel.Dock="Right"/>
                    <TextBlock Text="AD sites" VerticalAlignment="Center"/>
                  </DockPanel>
                </StackPanel>
                <ListBox Grid.Row="2" Name="DiscSites" SelectionMode="Extended" Margin="0,8,0,8"/>
                <StackPanel Grid.Row="3">
                  <TextBlock Text="...or subnets / ranges (one per line)" Style="{DynamicResource FieldLabel}"/>
                  <TextBox Name="DiscSubnets" AcceptsReturn="True" Height="56" VerticalContentAlignment="Top" TextWrapping="Wrap"/>
                  <TextBlock Text="Sources" Style="{DynamicResource FieldLabel}"/>
                  <WrapPanel>
                    <CheckBox Name="DiscSnmp" Content="SNMP scan" IsChecked="True"/>
                    <CheckBox Name="DiscDhcp" Content="DHCP" IsChecked="True"/>
                    <CheckBox Name="DiscPrintServer" Content="Print servers" IsChecked="True"/>
                    <CheckBox Name="DiscProbe" Content="Probe queue ports" IsChecked="True" ToolTip="Check each queue's port host to tell pull-print servers from real printers"/>
                  </WrapPanel>
                  <Button Name="DiscRun" Content="Run discovery" Style="{DynamicResource PrimaryButton}" Height="38" Margin="0,14,0,0" HorizontalAlignment="Stretch"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Grid.Column="2" Style="{DynamicResource Card}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                  <Button Name="DiscMerge" Content="Merge into catalog" Style="{DynamicResource PrimaryButton}" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                  <Button Name="DiscExport" Content="Export CSV" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                  <Button Name="DiscOnline" Content="Check online" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                  <TextBlock Name="DiscSummary" Text="No results yet" Style="{DynamicResource Muted}" VerticalAlignment="Center"/>
                </DockPanel>
                <DataGrid Grid.Row="1" Name="DiscGrid" IsReadOnly="True" SelectionMode="Extended">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding name}" Width="2*"/>
                    <DataGridTextColumn Header="IP" Binding="{Binding ip}" Width="115"/>
                    <DataGridTextColumn Header="Vendor" Binding="{Binding vendor}" Width="75"/>
                    <DataGridTextColumn Header="Model" Binding="{Binding model}" Width="2*"/>
                    <DataGridTextColumn Header="Serial" Binding="{Binding serial}" Width="110"/>
                    <DataGridTextColumn Header="Site" Binding="{Binding site}" Width="80"/>
                    <DataGridTextColumn Header="Queue" Binding="{Binding shareName}" Width="*"/>
                    <DataGridTextColumn Header="Kind" Binding="{Binding queueKind}" Width="65"/>
                    <DataGridTextColumn Header="Flags" Binding="{Binding flagsText}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- ~~~~~ Catalog ~~~~~ -->
        <Grid Name="PageCatalog" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Catalog" Style="{DynamicResource H1}"/>
            <TextBlock Name="CatalogPathText" Text="" Style="{DynamicResource Muted}"/>
          </StackPanel>
          <Border Grid.Row="1" Style="{DynamicResource Card}">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <Button Name="CatalogSave" Content="Save" Style="{DynamicResource PrimaryButton}" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                <Button Name="CatalogDelete" Content="Delete selected" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                <Button Name="CatalogOnline" Content="Check online" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                <Button Name="CatalogReload" Content="Reload" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                <ComboBox Name="CatalogSite" Width="170" Margin="0,0,8,0"/>
                <TextBox Name="CatalogSearch" ToolTip="Filter"/>
              </DockPanel>
              <DataGrid Grid.Row="1" Name="CatalogGrid" SelectionMode="Extended" CanUserDeleteRows="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Name" Binding="{Binding name}" Width="2*"/>
                  <DataGridTextColumn Header="IP" Binding="{Binding ip}" Width="115"/>
                  <DataGridTextColumn Header="Vendor" Binding="{Binding vendor}" Width="75"/>
                  <DataGridTextColumn Header="Model" Binding="{Binding model}" Width="2*" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Serial" Binding="{Binding serial}" Width="110" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Site" Binding="{Binding site}" Width="80"/>
                  <DataGridTextColumn Header="Location" Binding="{Binding location}" Width="*"/>
                  <DataGridTextColumn Header="Kind" Binding="{Binding queueKind}" Width="65" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Note" Binding="{Binding note}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
        </Grid>

        <!-- ~~~~~ Settings ~~~~~ -->
        <Grid Name="PageSettings" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Settings" Style="{DynamicResource H1}"/>
            <TextBlock Text="Configuration lives in settings.json. Edit it with any editor, then reload here." Style="{DynamicResource Muted}"/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="Configuration file" Style="{DynamicResource H2}"/>
                  <TextBlock Name="SettingsConfigPath" Text="" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                  <WrapPanel Margin="0,10,0,0">
                    <Button Name="SettingsCreate" Content="Create settings.json from example" Margin="0,0,8,0"/>
                    <Button Name="SettingsOpen" Content="Open in editor" Margin="0,0,8,0"/>
                    <Button Name="SettingsFolder" Content="Open folder" Margin="0,0,8,0"/>
                    <Button Name="SettingsReload" Content="Reload configuration" Style="{DynamicResource PrimaryButton}"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="Effective configuration" Style="{DynamicResource H2}"/>
                  <TextBox Name="SettingsDump" IsReadOnly="True" AcceptsReturn="True" Height="300" VerticalContentAlignment="Top" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </StackPanel>
              </Border>
              <Border Style="{DynamicResource Card}">
                <StackPanel>
                  <TextBlock Text="Driver packages" Style="{DynamicResource H2}"/>
                  <TextBlock Name="SettingsDriverRoot" Text="" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                  <TextBlock Text="Extract each vendor's universal driver package into a folder named after the vendor key (KM, HP, ...). The folder is zipped automatically and pushed to targets that lack the driver." Style="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                  <Button Name="SettingsDrivers" Content="Open driver folder" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>

      <!-- ~~~~~ Activity log ~~~~~ -->
      <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"/>
      <Border Grid.Row="2" Margin="24,0,24,16" Style="{DynamicResource Card}" Padding="0">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="14,8,8,4">
            <Button Name="LogClear" Content="Clear" Style="{DynamicResource GhostButton}" DockPanel.Dock="Right"/>
            <Button Name="LogCopy" Content="Copy" Style="{DynamicResource GhostButton}" DockPanel.Dock="Right"/>
            <ProgressBar Name="Busy" Width="120" IsIndeterminate="True" Visibility="Hidden" DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBlock Name="StatusText" Text="Ready" Style="{DynamicResource Muted}" VerticalAlignment="Center"/>
          </DockPanel>
          <ListBox Name="LogList" Style="{DynamicResource LogList}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="4,0,4,4"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
